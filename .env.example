# Copia este archivo a .env para desarrollo local.
# En Railway se configuran como Variables del servicio (NO subir el .env real).

# Secreto compartido con la tienda Next.js para firmar el webhook (HMAC-SHA256).
WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
REQUIRE_SIGNATURE=true

# Almacenamiento persistente. En Railway = punto de montaje del Volume.
STORAGE_DIR=data

# URL pública base para construir los enlaces de descarga de PDFs.
PUBLIC_BASE_URL=http://localhost:8000

# Rutas de assets y contenido (relativas a la raíz del proyecto).
ASSETS_DIR=assets
CONTENT_DIR=content

ENVIRONMENT=development

# --- Reportes dinámicos con IA ---
# Proveedor: "anthropic" (Claude) o "google" (Gemini · AI Studio).
AI_PROVIDER=anthropic

# Opción A · Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5        # calidad; claude-sonnet-5 abarata

# Opción B · Google AI Studio (https://aistudio.google.com/apikey)
#   AI_PROVIDER=google
#   GOOGLE_API_KEY=AIza...
#   AI_MODEL=gemini-2.5-pro      # o gemini-2.5-flash (tier gratuito generoso)

AI_MODEL=claude-opus-5
AI_EFFORT=high                  # sólo Anthropic
AI_MAX_TOKENS=16000
