<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ report_title }} · {{ person_name }}</title>
<style>{{ css|safe }}
/* Overrides por reporte: DESPUÉS del CSS para ganar el cascade. */
:root{
  --area:{{ area_hex }};
  --area-ink:{{ area_hex }};
  --area-soft:{{ area_soft }};
  --area-soft-alt:{{ area_soft_alt }};
  --area-deep:{{ area_deep }};
}</style>
</head>
<body>

{# ============ 1 · PORTADA ============ #}
<section class="page">
  <div class="cover-v2">
    <div class="stars"></div>
    <div class="ring a"></div>
    <div class="ring b"></div>
    <div class="ring c"></div>
    <div class="brand">Numerología Cotidiana</div>
    <div class="meganum"><span class="in" data-n="{{ cover_number_clean }}">{{ cover_number_clean }}</span></div>
    <div class="numlabel">
      {{ cover_number_label }}
      {% if cover_number_karmic %}<br><span class="karmic-flag">✷ vibración kármica</span>{% endif %}
    </div>
    <div class="block">
      <div class="eyebrow-line">Reporte personalizado</div>
      <h1>{{ data.titulo or report_title }}</h1>
      <div class="sub">{{ data.subtitulo }}</div>
      <div class="who-card">
        <span class="n">{{ person_name }}</span>
        <span class="d">{{ birth_long }}</span>
      </div>
    </div>
    <div class="frase-side">«{{ data.frase_clave }}»</div>
  </div>
</section>

{# ============ 2 · APERTURA / RETRATO ============ #}
<section class="page">
  <div class="sky"></div>
  <div class="aura tl"></div>
  <div class="wm" style="right:-18mm; top:-14mm;">{{ cover_number_clean }}</div>
  <div class="open-head">
    <div class="eyebrow">Tu retrato</div>
    <h2 class="t">{{ data.retrato.titulo }}</h2>
  </div>
  <div class="open-quote">
    <div class="mark">“</div>
    <div class="q">{{ data.frase_clave }}</div>
  </div>
  <div class="open-body body">
    <div class="col">{% for par in retrato_cols[0] %}<p>{{ par }}</p>{% endfor %}</div>
    {% if retrato_cols[1] %}<div class="col">{% for par in retrato_cols[1] %}<p>{{ par }}</p>{% endfor %}</div>{% endif %}
  </div>
  <div class="folio"><span>{{ person_name }}</span><span class="num">02</span></div>
</section>

{# ============ 3 · NÚMEROS (BENTO) ============ #}
<section class="page">
  <div class="sky"></div>
  <div class="aura br"></div>
  <div class="open-head">
    <div class="eyebrow">Tu mapa</div>
    <h2 class="t">Los números que te componen</h2>
  </div>
  <div class="bento-wrap">
    <div class="bento">
      {% for c in bento_tiles %}
      <div class="tile {{ c.variant }}">
        {% if c.karmic %}<span class="k">KÁRMICO</span>{% endif %}
        <span class="v">{{ c.value }}</span>
        <span class="l"><b>{{ c.title }}</b>{{ c.sub }}</span>
      </div>
      {% endfor %}
    </div>
    {% if numbers_note %}<div class="bento-note">{{ numbers_note|safe }}</div>{% endif %}
  </div>
  <div class="folio"><span>{{ report_title }}</span><span class="num">03</span></div>
</section>

{# ============ 4 · GRÁFICOS ============ #}
{% for chart in charts %}
<section class="page chart-page-v2">
  <div class="sky"></div>
  <div class="side-eyebrow">{{ chart.eyebrow }}</div>
  <div class="chart-head-v2">
    <div>
      <div class="eyebrow">Lectura visual</div>
      <h2 class="t sm">{{ chart.title }}</h2>
      <div class="chart-tag">Lectura visual</div>
    </div>
    <div class="big-idx">{{ "%02d"|format(loop.index) }}</div>
  </div>
  <div class="chart-card kind-{{ chart.kind }}">{{ chart.svg|safe }}</div>
  {% if chart.caption %}<div class="chart-note-v2"><div>{{ chart.caption|safe }}</div></div>{% endif %}
  <div class="folio"><span>Lectura visual</span><span class="num">{{ "%02d"|format(loop.index + 3) }}</span></div>
</section>
{% endfor %}

{# ============ 5 · SECCIONES (layouts alternados A/B) ============ #}
{% set chart_pages = charts|length %}
{% for sec in data.secciones %}
{% set rail = sec_rail[loop.index0] %}
{% if loop.index0 % 2 == 0 %}
<section class="page sec-a">
  <div class="sky"></div>
  <div class="wm">{{ rail.value if rail else "%02d"|format(loop.index) }}</div>
  <div class="band">
    <div class="idx">{{ "%02d"|format(loop.index) }}</div>
    <div class="rail-label">{{ sec.id|replace("-", " ") }}</div>
  </div>
  {% if rail %}
  <div class="medal">
    <div class="mv">{{ rail.value }}</div>
    <div class="ml">{{ rail.label }}</div>
  </div>
  {% endif %}
  <div class="content">
    <div class="eyebrow">{{ "%02d"|format(loop.index) }} · {{ sec.id|replace("-", " ") }}</div>
    <h2 class="t sm">{{ sec.titulo }}</h2>
    {% if sec_chips[loop.index0] %}<div class="sec-nums-inline">{{ sec_chips[loop.index0] }}</div>{% endif %}
    {% if sec.entradilla %}<div class="entradilla-v2">{{ sec.entradilla }}</div>{% endif %}
    {% set cols = sec_cols[loop.index0] %}
    <div class="sec-body">
      <div class="col">{% for par in cols[0] %}<p>{{ par }}</p>{% endfor %}</div>
      {% if cols[1] %}<div class="col">{% for par in cols[1] %}<p>{{ par }}</p>{% endfor %}</div>{% endif %}
    </div>
    {# Fuera del contenedor de columnas: column-span:all dentro de multicol
       mete a WeasyPrint en un loop infinito de paginación. #}
    {% if sec.destacado %}
    <div class="pull-v2 {{ sec.destacado.tipo if sec.destacado.tipo in ('cita','dato','alerta') else 'dato' }}">
      <div class="ic">{{ {'cita':'❝','dato':'◆','alerta':'▲'}.get(sec.destacado.tipo, '◆') }}</div>
      <div class="kt">{{ {'cita':'Del texto de Laura','dato':'Dato','alerta':'Atención'}.get(sec.destacado.tipo, 'Dato') }}</div>
      <p>{{ sec.destacado.texto }}</p>
    </div>
    {% endif %}
    {% if sec.cierre_accionable %}
    <div class="accion-v2">
      <div class="arrow">→</div>
      <div class="tx"><b>PRÁCTICA ·</b> {{ sec.cierre_accionable }}</div>
    </div>
    {% endif %}
  </div>
  <div class="folio"><span>{{ report_title }}</span><span class="num">{{ "%02d"|format(loop.index + 3 + chart_pages) }}</span></div>
</section>
{% else %}
<section class="page sec-b">
  <div class="sky"></div>
  <div class="header">
    <div class="idx-ghost">{{ "%02d"|format(loop.index) }}</div>
    <div class="eyebrow">{{ "%02d"|format(loop.index) }} · {{ sec.id|replace("-", " ") }}</div>
    <h2 class="t sm">{{ sec.titulo }}</h2>
    {% if sec_chips[loop.index0] %}<div class="nums">{{ sec_chips[loop.index0] }}</div>{% endif %}
  </div>
  <div class="wm">{{ rail.value if rail else "%02d"|format(loop.index) }}</div>
  <div class="content">
    {% if sec.entradilla %}<div class="entradilla-v2">{{ sec.entradilla }}</div>{% endif %}
    {% set cols = sec_cols[loop.index0] %}
    <div class="sec-body">
      <div class="col">{% for par in cols[0] %}<p>{{ par }}</p>{% endfor %}</div>
      {% if cols[1] %}<div class="col">{% for par in cols[1] %}<p>{{ par }}</p>{% endfor %}</div>{% endif %}
    </div>
    {# Fuera del contenedor de columnas: column-span:all dentro de multicol
       mete a WeasyPrint en un loop infinito de paginación. #}
    {% if sec.destacado %}
    <div class="pull-v2 {{ sec.destacado.tipo if sec.destacado.tipo in ('cita','dato','alerta') else 'dato' }}">
      <div class="ic">{{ {'cita':'❝','dato':'◆','alerta':'▲'}.get(sec.destacado.tipo, '◆') }}</div>
      <div class="kt">{{ {'cita':'Del texto de Laura','dato':'Dato','alerta':'Atención'}.get(sec.destacado.tipo, 'Dato') }}</div>
      <p>{{ sec.destacado.texto }}</p>
    </div>
    {% endif %}
    {% if sec.cierre_accionable %}
    <div class="accion-v2">
      <div class="arrow">→</div>
      <div class="tx"><b>PRÁCTICA ·</b> {{ sec.cierre_accionable }}</div>
    </div>
    {% endif %}
  </div>
  <div class="folio"><span>{{ report_title }}</span><span class="num">{{ "%02d"|format(loop.index + 3 + chart_pages) }}</span></div>
</section>
{% endif %}
{% endfor %}

{# ============ 6 · TENSIÓN CENTRAL (diagonal) ============ #}
<section class="page">
  <div class="tension-v2">
    <div class="grain"></div>
    <div class="seam"></div>
    <div class="head">
      <div class="eyebrow">La tensión central</div>
      <h2 class="t">{{ data.tension_central.titulo }}</h2>
    </div>
    {% if data.tension_central.numeros|length >= 2 %}
    <div class="duel">
      <div class="n left">{{ tension_orbs[0] }}<small>{{ tension_labels[0] }}</small></div>
      <div class="versus">CONTRA</div>
      <div class="n right">{{ tension_orbs[1] }}<small>{{ tension_labels[1] }}</small></div>
    </div>
    {% endif %}
    <div class="argument">
      <div class="col">{% for par in tension_cols[0] %}<p>{{ par }}</p>{% endfor %}</div>
      {% if tension_cols[1] %}<div class="col">{% for par in tension_cols[1] %}<p>{{ par }}</p>{% endfor %}</div>{% endif %}
    </div>
    {% if data.tension_central.como_resolverla %}
    <div class="resolve-v2">
      <div class="kt">Cómo resolverla</div>
      <p>{{ data.tension_central.como_resolverla }}</p>
    </div>
    {% endif %}
  </div>
</section>

{# ============ 7 · PLAN (línea de tiempo) ============ #}
<section class="page">
  <div class="sky"></div>
  <div class="aura tl"></div>
  <div class="open-head">
    <div class="eyebrow">Tu plan</div>
    <h2 class="t">Prácticas para esta vuelta</h2>
  </div>
  <div class="plan-intro">{{ data.frase_clave }}</div>
  <div class="plan-v2">
    {% for pr in data.plan %}
    <div class="step">
      <div class="dot">{{ loop.index }}</div>
      <h4>{{ pr.titulo }}</h4>
      <p>{{ pr.texto }}</p>
    </div>
    {% endfor %}
  </div>
  <div class="folio"><span>Tu plan</span><span class="num">{{ "%02d"|format(5 + chart_pages + data.secciones|length) }}</span></div>
</section>

{# ============ 8 · CIERRE ============ #}
<section class="page">
  <div class="final-v2">
    <div class="ring a"></div>
    <div class="ring b"></div>
    <div class="inner">
      <div class="eyebrow">Para terminar</div>
      <div class="closing">{{ data.cierre or data.frase_clave }}</div>
      <div class="sello">
        <div class="b">Numerología Cotidiana</div>
        <div class="line"></div>
        <div class="b">{{ person_name }}</div>
      </div>
    </div>
    <div class="legal">{{ legal }}</div>
  </div>
</section>

</body>
</html>
